rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cài đặt trang chủ (featuredEventIds): ai cũng đọc được để xem block "Sự kiện nổi bật"; chỉ admin ghi
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }
    // User profile: user tự tạo/sửa; admin (admin@gmail.com) đọc tất cả
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'admin@gmail.com');
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Sự kiện: chủ sở hữu đọc mọi status; admin đọc tất cả; người khác chỉ đọc approved
    match /events/{eventId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.createdBy)
        || (request.auth != null && request.auth.token.email == 'admin@gmail.com');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || request.auth.token.email == 'admin@gmail.com');
      // Cập nhật phát triển: chỉ chủ sự kiện tạo; đọc theo quyền đọc event
      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.status == 'approved'
          || request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid
          || request.auth != null && request.auth.token.email == 'admin@gmail.com';
        allow create: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
      }
    }
    // MỞ ALL: ai cũng đọc được mọi document (users, events draft/pending, settings, v.v.)
    // Ghi (create/update/delete) vẫn do các rule cụ thể bên trên kiểm soát.
    match /{document=**} {
      allow read: if true;
    }
  }
}
